<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sync_widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_brand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SYNC  ·  PERSONAL COMMAND CENTER"
        android:textColor="#77DDF5"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#9BAEC4"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="top"
        android:maxLines="24"
        android:paddingTop="8dp"
        android:text="Buka SYNC untuk menyinkronkan data widget."
        android:textColor="#EFF7FF"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_add_task"
            style="@style/SyncWidgetAction"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_add_task"
            android:text="+ Tugas" />

        <Button
            android:id="@+id/widget_calendar_action"
            style="@style/SyncWidgetAction"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_open_calendar"
            android:text="Agenda" />

        <Button
            android:id="@+id/widget_finance_action"
            style="@style/SyncWidgetAction"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_open_finance"
            android:text="Uang" />

        <Button
            android:id="@+id/widget_reminder_action"
            style="@style/SyncWidgetAction"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_open_reminders"
            android:text="Ingat" />
    </LinearLayout>
</LinearLayout>
